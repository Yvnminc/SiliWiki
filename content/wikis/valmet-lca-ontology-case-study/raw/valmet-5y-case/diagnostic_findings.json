  "findings": [
    {
      "diagnosis_id": "D1",
      "title": "Corporate GHG inventory evidence is auditable but not product-LCA-ready",
      "severity": "medium",
      "diagnosis": "The extracted ontology contains Scope 1 evidence for all five years (2018–2022), with Scope 1 increasing from 17.7 to 21.1 thousand tCO2 (19.2%). Scope 2 location/market-based evidence is source-grounded for 2018–2019, but later Scope 2 rows were not captured in this rule-provider pilot and need manual/LLM extraction validation.",
      "lca_implication": "This is suitable for corporate inventory review and longitudinal disclosure analysis. It is not sufficient for product LCA because it is corporate-scope inventory, not product-specific foreground activity data with functional unit and system boundary.",
      "evidence_ids": [
