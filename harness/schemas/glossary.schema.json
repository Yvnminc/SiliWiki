{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siliwiki.local/schemas/glossary.schema.json",
  "title": "SiliWiki glossary.json",
  "type": "object",
  "properties": {
    "version": { "type": "string" },
    "updated": { "type": "string" },
    "description": { "type": "string" },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "title"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string" },
          "color": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "display", "definition"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "display": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "category": { "type": "string" },
          "short": { "type": "string" },
          "definition": { "type": "string" },
          "related": { "type": "array", "items": { "type": "string" } },
          "sources": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
